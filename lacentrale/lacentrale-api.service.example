[Unit]
Description=Self-hosted La Centrale Search API
# Wants is required: After alone never pulls network-online.target in.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/claude-connect/lacentrale
EnvironmentFile=/path/to/claude-connect/.env
ExecStart=/bin/bash -lc 'exec /path/to/claude-connect/lacentrale/.venv/bin/uvicorn app.main:app --host "${CENTRALE_HOST:-127.0.0.1}" --port "${CENTRALE_PORT:-8094}"'
Restart=always
RestartSec=5
MemoryMax=512M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
