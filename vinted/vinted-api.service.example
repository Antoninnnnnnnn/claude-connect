[Unit]
Description=Self-hosted Vinted Search API
# Wants is required: After alone never pulls network-online.target in.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/claude-connect/vinted
EnvironmentFile=/path/to/claude-connect/.env
ExecStart=/bin/bash -lc 'exec /path/to/claude-connect/vinted/.venv/bin/uvicorn app.main:app --host "${VINTED_HOST:-127.0.0.1}" --port "${VINTED_PORT:-8091}"'
Restart=always
RestartSec=5
MemoryMax=384M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
