# Fichier commun a tous les services. Copier vers .env et adapter.
# Ne jamais committer .env : il contient la cle API et les identifiants.

# Cle partagee, exigee sur tous les endpoints proteges via l'en-tete X-API-Key.
API_KEY=change-me

# --- Vinted (port 8091) ---------------------------------------------------
# Les services ecoutent en loopback : seul le reverse proxy local les joint.
VINTED_HOST=127.0.0.1
VINTED_PORT=8091
VINTED_DEFAULT_DOMAIN=fr
VINTED_PROXY=
VINTED_TIMEOUT=20
VINTED_MIN_INTERVAL=1.2
VINTED_MAX_RETRIES=3
VINTED_COOKIE_FILE=vinted/data/cookies.json

# --- Leboncoin (port 8092) ------------------------------------------------
LBC_HOST=127.0.0.1
LBC_PORT=8092
LBC_PROXY=
LBC_PROXIES=
DECODO_PROXY=
DATAIMPULSE_PROXY=
EVOMI_PROXY=
# Court expres : une IP de sortie residentielle bridee est abandonnee au lieu d'etre attendue.
LBC_TIMEOUT=12
LBC_MIN_INTERVAL=1.5
LBC_MAX_RETRIES=6
LBC_SLOW_SESSION_SECONDS=4
# Tout passe par le pool de proxys ; true autorise un repli en direct si le pool echoue.
LBC_ALLOW_DIRECT_FALLBACK=false
# L'API JSON mobile Leboncoin exige une empreinte TLS mobile (les profils desktop sont 403).
LBC_IMPERSONATES=safari_ios,chrome_android,firefox
# Fait tourner le point d'entree dans le pool a chaque requete (sans effet si un seul proxy).
LBC_ROTATE_PROXY_PER_REQUEST=true
LBC_MAX_PAGES_PER_SEARCH=3
# Duree de vie d'une session chaude (cookie DataDome reutilise) : evite de re-primer a chaque appel.
LBC_SESSION_TTL=600
LBC_CACHE_TTL=20
LBC_CACHE_MAX_ENTRIES=256

# --- EcoleDirecte (port 8093) ---------------------------------------------
ED_HOST=127.0.0.1
ED_PORT=8093
ED_USERNAME=
ED_PASSWORD=
# Reponses au QCM de securite. Fichier personnel, ignore par git.
ED_QCM_FILE=ecoledirecte/qcm.json
# EcoleDirecte bloque un compte apres quelques logins refuses : les echecs sont
# espaces exponentiellement au lieu d'etre rejoues a chaque appel d'API.
ED_LOGIN_BACKOFF_BASE=30
ED_LOGIN_BACKOFF_MAX=1800
ED_LOGIN_TIMEOUT=20
# Identifiants refuses ce nombre de fois : plus aucune tentative jusqu'au
# redemarrage ou jusqu'a une nouvelle reponse QCM.
ED_MAX_CREDENTIAL_FAILURES=3

# --- La Centrale (port 8094) ----------------------------------------------
CENTRALE_HOST=127.0.0.1
CENTRALE_PORT=8094
CENTRALE_PROXY=
CENTRALE_PROXIES=
# Cle publique du front lacentrale.fr. Laisser vide : elle est extraite du bundle JS.
CENTRALE_UPSTREAM_API_KEY=
CENTRALE_UPSTREAM_API_KEY_FALLBACKS=
CENTRALE_CLIENT_SOURCE=lc:recherche:front
CENTRALE_TIMEOUT=45
CENTRALE_MIN_INTERVAL=1.5
CENTRALE_MAX_RETRIES=3
# DataDome bloque les empreintes TLS desktop depuis 2026-08 ; les mobiles passent.
CENTRALE_IMPERSONATES=chrome_android,chrome131_android
CENTRALE_ROTATE_PROXY_PER_REQUEST=true
CENTRALE_MAX_PAGES_PER_SEARCH=3
CENTRALE_CACHE_TTL=20
CENTRALE_CACHE_MAX_ENTRIES=256
CENTRALE_LISTING_CACHE_TTL=3600
CENTRALE_LISTING_CACHE_MAX_ENTRIES=128
# Plafond dur de concurrence sur /listings (le parametre max_workers ne peut pas le depasser).
CENTRALE_LISTING_MAX_WORKERS=4
CENTRALE_METADATA_CACHE_TTL=300
CENTRALE_COOKIE_FILE=lacentrale/data/cookies.json
# auto | json | ssr
CENTRALE_PRIMARY_STRATEGY=auto
CENTRALE_WWW_USE_PROXY=true
CENTRALE_WARMUP_ON_START=false

# Clearance DataDome frappee par navigateur pour le HTML www.lacentrale.fr.
CENTRALE_BROWSER_ENABLED=true
CENTRALE_BROWSER_PYTHON=.venv-browser/bin/python
# Le check anti-bot ne se resout qu'en mode fenetre : xvfb-run sur un hote sans ecran.
CENTRALE_BROWSER_XVFB=true
CENTRALE_BROWSER_PROXY=
CENTRALE_BROWSER_MINT_ATTEMPTS=4
CENTRALE_BROWSER_MINT_TIMEOUT=420
CENTRALE_BROWSER_MINT_COOLDOWN=300
# Le mint tourne en tache de fond ; une requete l'attend au plus ce nombre de
# secondes. Garder bien en dessous du proxy_read_timeout nginx (90s).
CENTRALE_BROWSER_MINT_WAIT=25
CENTRALE_DATADOME_TOKEN_FILE=lacentrale/data/datadome_token.json
CENTRALE_DATADOME_TOKEN_MAX_AGE=3600
# La clearance survit a un espacement de 5s, mais grille a ~1 req/s.
CENTRALE_WWW_MIN_INTERVAL=5
CENTRALE_WWW_IMPERSONATE=chrome
# Les cookies de clearance sont portables entre IP : le HTML evite le proxy facture.
CENTRALE_WWW_FETCH_USE_PROXY=false
