API_KEY=change-me

VINTED_HOST=0.0.0.0
VINTED_PORT=8091
VINTED_DEFAULT_DOMAIN=fr
VINTED_PROXY=
VINTED_TIMEOUT=20
VINTED_MIN_INTERVAL=1.2
VINTED_MAX_RETRIES=3
VINTED_COOKIE_FILE=vinted/data/cookies.json

LBC_HOST=0.0.0.0
LBC_PORT=8092
LBC_PROXY=
LBC_PROXIES=
DECODO_PROXY=
DATAIMPULSE_PROXY=
EVOMI_PROXY=
# Court exprès : une IP de sortie residentielle bridee est abandonnee au lieu d'etre attendue.
LBC_TIMEOUT=12
LBC_MIN_INTERVAL=1.5
LBC_MAX_RETRIES=6
LBC_SLOW_SESSION_SECONDS=4
# Tout passe par le pool de proxys ; true autorise un repli en direct si le pool echoue.
LBC_ALLOW_DIRECT_FALLBACK=false
# L'API JSON mobile Leboncoin exige une empreinte TLS mobile (les profils desktop sont 403).
LBC_IMPERSONATES=safari_ios,chrome_android,firefox
LBC_ROTATE_PROXY_PER_REQUEST=true
LBC_MAX_PAGES_PER_SEARCH=3
# Duree de vie d'une session chaude (cookie DataDome reutilise) : evite de re-primer a chaque appel.
LBC_SESSION_TTL=600
LBC_CACHE_TTL=20
LBC_CACHE_MAX_ENTRIES=256
