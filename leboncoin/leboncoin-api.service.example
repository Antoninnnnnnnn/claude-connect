[Unit]
Description=Self-hosted Leboncoin Search API
# Wants is required: After alone never pulls network-online.target in.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/claude-connect/leboncoin
EnvironmentFile=/path/to/claude-connect/.env
ExecStart=/bin/bash -lc 'exec /path/to/claude-connect/leboncoin/.venv/bin/uvicorn app.main:app --host "${LBC_HOST:-127.0.0.1}" --port "${LBC_PORT:-8092}"'
Restart=always
RestartSec=5
MemoryMax=384M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
